# Domínio público do checklist
CHECKLIST_DOMAIN=checklist.cmwtransportes.org

# URL base da API/webhooks do n8n ou backend
# Exemplo: https://n8n.cmwtransportes.org/webhook
# Se os webhooks estiverem no mesmo domínio do app, use: https://checklist.cmwtransportes.org
API_BASE=https://checklist.cmwtransportes.org

# Token da aplicação usado pelo frontend para chamar os webhooks
TOKEN_APP=troque-este-token

# Debug do frontend: true ou false
APP_DEBUG=false

# Usado somente no compose do Traefik, se necessário
ACME_EMAIL=seu-email@dominio.com
